# NRLMSISE-00 C source, obtained from its maintainer rather than redistributed here.
# See THIRD-PARTY-NOTICES.md; NonGravForces.buildMex tells you what to do if it is missing.
mex/nrlmsise00/

# NRLMSIS 2.1 Fortran package of NRL (Open Source Academic Research License: not redistributed).
# setupNonGravForces fetches the release tarball and checks its SHA-256.
mex/nrlmsis21/

# HWM14 Fortran and data (NRL; no redistribution grant). setupNonGravForces fetches them by SHA-256.
mex/hwm14/

# Python bytecode caches of the audit and build scripts
__pycache__/

# Third-party papers and theses read while building the toolbox (80 MB, copyrighted,
# not redistributable). Kept locally, never committed; the toolbox cites them by DOI.
doc/references/
tools/benchmark_last.txt

# Full products fetched by setupNonGravForces('FetchData', ...): never committed. The committed
# excerpts under data/ carry dated names (eop, space weather) or live in data/samples (Level-1B).
data/eop/finals2000A.all
data/spaceweather/SW-All.csv
data/l1b/
data/ceres/*_200003-202509.nc

# The theory document is BUILT from doc/src, never committed (O-38): the CI job "theory"
# compiles it and uploads the PDF as a run artefact.
doc/*.pdf
doc/src/*.pdf
doc/src/*.aux
doc/src/*.log
doc/src/*.out
doc/src/*.toc

# The DE440 ephemeris is FETCHED by setupNonGravForces, never committed: 33 MB that NAIF
# publishes and keeps current (the same case as the MSIS and HWM14 sources, O-34).
data/kernels/

# GROOPS data (albedo grids, CERES SYN1deg climatologies) is FETCHED into DATAPOOL by
